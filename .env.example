# ==============================================================================
# OMEN AI Portfolio Agent — Environment Variables
# NEVER commit real API keys or secrets to version control.
# Configure these in your deployment platform (Netlify / Vercel) separately.
# ==============================================================================

# Google Gemini API Key (SERVER-SIDE ONLY — NEVER prefix with VITE_)
# Get a free key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model ID (default: gemini-3.1-flash-lite)
# See supported models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.1-flash-lite

# Resend API key for contact form email notifications
# Get a key from: https://resend.com/
RESEND_API_KEY=your_resend_api_key_here
