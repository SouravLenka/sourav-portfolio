# ==============================================================================
# OMEN AI Portfolio Agent & Server Environment Variables
# NEVER commit real API keys or secrets to version control.
# Configure these in your deployment dashboard (Netlify/Vercel) and local .env file.
# ==============================================================================

# Google Gemini API Key (Server-side only)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Model (Default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-2.5-flash, etc.
GEMINI_MODEL=gemini-1.5-flash

# Resend API Key for contact form email notifications
# Get a key from: https://resend.com/
RESEND_API_KEY=your_resend_api_key_here
